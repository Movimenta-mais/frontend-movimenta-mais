# Copie este arquivo para .env.local e preencha os valores necessários.
# Nunca versione arquivos .env com valores reais.
#
# Variáveis com prefixo NEXT_PUBLIC_ ficam expostas no navegador.
# Variáveis sem o prefixo ficam disponíveis apenas no servidor.
#
# Exemplo:
# NEXT_PUBLIC_API_URL=https://api.exemplo.com
